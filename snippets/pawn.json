  "Public function with forward": {
    "prefix": "public",
    "body": [
      "forward ${1:FunctionName}(${2:playerid});",
      "public ${1:FunctionName}(${2:playerid})",
      "{",
      "\t$0",
      "\treturn 1;",
      "}"
    ],
    "description": "Public function with its matching forward"
  },
