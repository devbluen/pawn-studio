      "\treturn 1;",
      "}"
    ],
    "description": "Stock function (only compiled when used)"
  },
  "Player loop (for)": {
    "prefix": "forplayers",
    "body": [
      "for (new ${1:i} = 0, ${2:j} = GetPlayerPoolSize(); ${1:i} <= ${2:j}; ${1:i}++)",
      "{",
      "\tif (!IsPlayerConnected(${1:i})) continue;",
      "\t$0",
      "}"
    ],
    "description": "for loop over all connected players"
  },
  "Loop for": {
    "prefix": "for",
    "body": [
      "for (new ${1:i} = 0; ${1:i} < ${2:MAX_PLAYERS}; ${1:i}++)",
      "{",
      "\t$0",
      "}"
    ],
    "description": "Simple for loop"
  },
  "foreach players": {
    "prefix": "foreach",
    "body": [
      "foreach (new ${1:i} : ${2:Player})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "foreach loop (y_iterate / foreach.inc) over an iterator"
  },
  "Enum with array": {
    "prefix": "enum",
    "body": [
      "enum E_${1:PLAYER_DATA}",
      "{",
      "\tE_${2:NAME}[${3:MAX_PLAYER_NAME}],",
      "\tFloat:E_${4:HEALTH},",
      "\tE_${5:MONEY}",
      "}",
      "new ${6:PlayerData}[${7:MAX_PLAYERS}][E_${1:PLAYER_DATA}];",
      "$0"
    ],
    "description": "Enum with E_ prefix and the array that uses it"
  },
  "format + SendClientMessage": {
    "prefix": "format",
    "body": [
      "new ${1:string}[${2:144}];",
      "format(${1:string}, sizeof ${1:string}, \"${3:{FFFFFF\\}Text %d}\", ${4:value});",
      "SendClientMessage(${5:playerid}, ${6:-1}, ${1:string});",
      "$0"
    ],
    "description": "Formats a string and sends it to the player"
  },
  "SendClientMessage": {
    "prefix": "scm",
    "body": [
      "SendClientMessage(${1:playerid}, ${2:-1}, \"${3:Message}\");$0"
    ],
    "description": "Sends a message to the player"
  },
  "ShowPlayerDialog with switch": {
    "prefix": "dialog",
    "body": [
      "ShowPlayerDialog(${1:playerid}, ${2:DIALOG_ID}, ${3|DIALOG_STYLE_MSGBOX,DIALOG_STYLE_INPUT,DIALOG_STYLE_LIST,DIALOG_STYLE_PASSWORD,DIALOG_STYLE_TABLIST,DIALOG_STYLE_TABLIST_HEADERS|}, \"${4:Title}\", \"${5:Item 1\\nItem 2}\", \"${6:Ok}\", \"${7:Cancel}\");",
      "",
      "// in OnDialogResponse:",
      "case ${2:DIALOG_ID}:",
      "{",
      "\tif (!response) return 1;",
      "\tswitch (listitem)",
      "\t{",
      "\t\tcase 0: {$0}",
      "\t\tcase 1: {}",
      "\t}",
      "\treturn 1;",
      "}"
    ],
    "description": "Shows a dialog and the response case with switch(listitem)"
  },
  "CMD command (zcmd / Pawn.CMD)": {
    "prefix": "cmd",
    "body": [
      "CMD:${1:command}(playerid, params[])",
      "{",
      "\t$0",
      "\treturn 1;",
      "}"
    ],
    "description": "zcmd / Pawn.CMD style command"
  },
  "YCMD command (y_commands)": {
    "prefix": "ycmd",
    "body": [
      "YCMD:${1:command}(playerid, params[], help)",
      "{",
      "\tif (help) return SendClientMessage(playerid, -1, \"${2:Command help.}\");",
      "\t$0",
      "\treturn 1;",
      "}"
    ],
    "description": "y_commands style command (YSI)"
  },
  "SetTimerEx + callback": {
    "prefix": "settimerex",
    "body": [
      "SetTimerEx(\"${1:TimerName}\", ${2:1000}, ${3|false,true|}, \"${4:i}\", ${5:playerid});",
      "",
      "forward ${1:TimerName}(${5:playerid});",
      "public ${1:TimerName}(${5:playerid})",
      "{",
      "\t$0",
      "\treturn 1;",
      "}"
    ],
    "description": "Timer with parameters and its matching public callback"
  },
  "SetTimer + callback": {
    "prefix": "settimer",
    "body": [
      "SetTimer(\"${1:TimerName}\", ${2:1000}, ${3|true,false|});",
      "",
      "forward ${1:TimerName}();",
      "public ${1:TimerName}()",
      "{",
      "\t$0",
      "\treturn 1;",
      "}"
    ],
    "description": "Global timer and its matching public callback"
  },
  "Include guard": {
    "prefix": "guard",
    "body": [
      "#if defined _inc_${1:${TM_FILENAME_BASE}}",
      "\t#endinput",
      "#endif",
      "#define _inc_${1:${TM_FILENAME_BASE}}",
      "",
      "$0"
    ],
    "description": "Protection against double inclusion (#if defined ... #endinput)"
  },
