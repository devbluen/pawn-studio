          "match": "\\\\\\s*$",
          "name": "constant.character.escape.line-continuation.pawn"
        }
      ]
    },
    "string-format": {
      "patterns": [
        {
          "match": "%%",
          "name": "constant.character.escape.percent.pawn"
        },
        {
          "match": "%[-+0#]*(?:[0-9]+|\\*)?(?:\\.(?:[0-9]+|\\*))?[dibcfsxXqeuph]",
          "name": "constant.other.placeholder.pawn"
        },
