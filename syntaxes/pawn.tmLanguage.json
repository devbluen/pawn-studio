{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pawn",
  "scopeName": "source.pawn",
  "fileTypes": [
    "pwn",
    "inc",
    "p",
    "pawn"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#code"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.pawn",
          "begin": "/\\*\\*(?![/*])",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.pawn"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.pawn"
            }
          },
          "patterns": [
            {
              "include": "#todo"
            },
            {
              "include": "#doc-tags"
            }
          ]
        },
        {
          "name": "comment.block.pawn",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.pawn"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.pawn"
            }
          },
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        },
        {
          "name": "comment.block.documentation.pawn",
          "begin": "///(?!/)",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.pawn"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#todo"
            },
            {
              "include": "#doc-tags"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.pawn",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.pawn"
            }
          },
          "end": "(?<!\\\\)(?=\\n)",
          "patterns": [
            {
              "include": "#todo"
            }
          ]
        }
      ]
    },
    "todo": {
      "match": "\\b(TODO|FIXME|XXX|HACK|BUG|NOTE|OPTIMIZE)\\b:?",
      "name": "comment.todo.pawn"
    },
    "doc-tags": {
      "patterns": [
        {
          "match": "(?<![\\w@])@(param|return|returns|brief|remarks|note|see|deprecated|example|author|tparam)\\b",
          "name": "storage.type.class.doc.pawn"
        },
        {
          "match": "</?[A-Za-z][\\w-]*(?:\\s+[^>]*)?/?>",
          "name": "entity.name.tag.documentation.pawn"
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.include.pawn",
          "begin": "^\\s*((#)\\s*(include|tryinclude))\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.$3.pawn"
            },
            "2": {
              "name": "punctuation.definition.directive.pawn"
            }
          },
          "end": "(?<!\\\\)(?=\\n)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "name": "string.quoted.other.lt-gt.include.pawn",
              "match": "(<)[^>]*(>)",
              "captures": {
                "1": {
                  "name": "punctuation.definition.string.begin.pawn"
                },
                "2": {
                  "name": "punctuation.definition.string.end.pawn"
                }
              }
            },
            {
              "name": "string.quoted.double.include.pawn",
              "match": "(\")[^\"]*(\")",
              "captures": {
                "1": {
                  "name": "punctuation.definition.string.begin.pawn"
                },
                "2": {
                  "name": "punctuation.definition.string.end.pawn"
                }
              }
            },
            {
              "name": "string.unquoted.include.pawn",
              "match": "[^\\s/]+"
            }
          ]
        },
        {
          "name": "meta.preprocessor.macro.pawn",
          "begin": "^\\s*((#)\\s*define)\\s+([A-Za-z_@][\\w@]*)(?=[(:])",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.define.pawn"
            },
            "2": {
              "name": "punctuation.definition.directive.pawn"
            },
            "3": {
              "name": "entity.name.function.preprocessor.pawn"
            }
          },
          "end": "(?<!\\\\)(?=\\n)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "match": "%[0-9]",
              "name": "variable.parameter.preprocessor.pawn"
            },
            {
              "match": "\\\\\\s*$",
              "name": "constant.character.escape.line-continuation.pawn"
            },
            {
              "include": "#code"
            }
          ]
        },
        {
          "name": "meta.preprocessor.macro.pawn",
          "begin": "^\\s*((#)\\s*define)\\s+([A-Za-z_@][\\w@]*)",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.define.pawn"
            },
            "2": {
              "name": "punctuation.definition.directive.pawn"
            },
            "3": {
              "name": "variable.other.constant.preprocessor.pawn"
            }
          },
          "end": "(?<!\\\\)(?=\\n)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "match": "%[0-9]",
              "name": "variable.parameter.preprocessor.pawn"
            },
            {
              "match": "\\\\\\s*$",
              "name": "constant.character.escape.line-continuation.pawn"
            },
            {
              "include": "#code"
            }
          ]
        },
        {
          "name": "meta.preprocessor.diagnostic.pawn",
          "begin": "^\\s*((#)\\s*(error|warning))\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.diagnostic.$3.pawn"
            },
            "2": {
              "name": "punctuation.definition.directive.pawn"
            }
          },
          "end": "(?<!\\\\)(?=\\n)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#strings"
            },
            {
              "match": "\\\\\\s*$",
              "name": "constant.character.escape.line-continuation.pawn"
            },
            {
              "match": "[^\\s\"/\\\\]+",
              "name": "string.unquoted.single.pawn"
            }
          ]
        },
        {
          "name": "meta.preprocessor.pragma.pawn",
          "begin": "^\\s*((#)\\s*pragma)\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.pragma.pawn"
            },
            "2": {
              "name": "punctuation.definition.directive.pawn"
            }
          },
          "end": "(?<!\\\\)(?=\\n)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "match": "\\\\\\s*$",
              "name": "constant.character.escape.line-continuation.pawn"
            },
            {
              "match": "\\b(align|amxlimit|amxram|codepage|compress|ctrlchar|deprecated|dynamic|library|naked|nodestruct|option|overlay|pack|rational|semicolon|tabsize|unused|unread|unwritten|warning|disable|enable|push|pop|compat|stack|heap)\\b",
              "name": "entity.other.attribute-name.pragma.pawn"
            },
            {
              "include": "#code"
            }
          ]
        },
        {
          "name": "meta.preprocessor.emit.pawn",
          "begin": "^\\s*((#)\\s*emit)\\b\\s*([A-Za-z]+(?:\\.[A-Za-z]+)*)?",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.emit.pawn"
            },
            "2": {
              "name": "punctuation.definition.directive.pawn"
