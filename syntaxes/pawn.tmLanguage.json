        {
          "name": "meta.function.pawn",
          "begin": "(?:(?<![\\w@])(CMD|COMMAND|YCMD|ZCMD|PCMD|ACMD|DCMD|SSCANF|cmd|command|dialog|Dialog|DIALOG)|^\\s*([a-z][a-z0-9_]*))(:)([A-Za-z_@][\\w@]*)\\s*(?=\\()",
