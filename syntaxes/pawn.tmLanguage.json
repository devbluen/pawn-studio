      "begin": "(?<![\\w@])(public|stock|native|forward|static)\\b((?:\\s+(?:stock|static|const|public))*)\\s+((?:\\{\\s*[A-Za-z_@][\\w@]*(?:\\s*,\\s*[A-Za-z_@][\\w@]*)*\\s*\\}|[A-Za-z_@][\\w@]*):\\s*)?([A-Za-z_@][\\w@]*)\\s*(?=\\()",
