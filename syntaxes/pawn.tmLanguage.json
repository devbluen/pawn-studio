    "command-macro": {
      "patterns": [
        {
          "match": "(?<![\\w@])(desc|description|help|flags|alias|aliases|params|usage)(:)([A-Za-z_@][\\w@]*)\\s*(?=\\()",
          "captures": {
            "1": {
