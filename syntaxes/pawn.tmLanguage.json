            "3": {
              "name": "entity.name.function.opcode.pawn"
            }
          },
          "end": "(?<!\\\\)(?=\\n)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "include": "#code"
            }
          ]
        },
        {
          "name": "meta.preprocessor.pawn",
          "begin": "^\\s*((#)\\s*(if|elseif|else|endif|undef|assert|endinput|endscript|section|line|file|error|warning))\\b",
          "beginCaptures": {
            "1": {
              "name": "keyword.control.directive.$3.pawn"
            },
            "2": {
              "name": "punctuation.definition.directive.pawn"
            }
          },
          "end": "(?<!\\\\)(?=\\n)",
          "patterns": [
            {
              "include": "#comments"
            },
            {
              "match": "\\\\\\s*$",
              "name": "constant.character.escape.line-continuation.pawn"
            },
            {
              "match": "(?<![\\w@])(defined)\\s+([A-Za-z_@][\\w@]*)",
              "captures": {
                "1": {
                  "name": "keyword.operator.defined.pawn"
                },
                "2": {
                  "name": "variable.other.constant.preprocessor.pawn"
                }
              }
            },
            {
              "include": "#code"
            }
          ]
        }
      ]
    },
